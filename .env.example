# Copy to .env. Never commit .env.

# Tailscale auth key (admin console -> Settings -> Keys). Only used on first start;
# afterwards the node's identity lives in the tailscale-state volume.
TS_AUTHKEY=

# Canvas -> Calendar -> "Calendar Feed". Anyone with this URL can read your calendar.
CANVAS_FEED_URL=

# For the `gradescope` source: the Cookie request header from a logged-in gradescope.com
# tab (DevTools -> Network -> reload -> the www.gradescope.com request -> Request
# Headers -> cookie). Treat it like a password: it can do anything you can on Gradescope.
# The dashboard only reads pages with it.
GRADESCOPE_COOKIE=

# Optional, for the `canvas` source: the Cookie request header from a logged-in
# canvas.uw.edu tab (DevTools -> Network -> any canvas.uw.edu request -> Cookie).
# CANVAS_COOKIE=

# The planner and tutor (the agent container): your Claude API key, from
# platform.claude.com -> API keys. Only the agent container gets it.
ANTHROPIC_API_KEY=

# Where prime-agent is installed on this server: the folder that has bin/prime-agent.
PRIME_AGENT_DIR=/home/you/.local/share/prime-agent

# Your user and group ids on this server (`id -u`, `id -g`). Both containers run as you,
# so ./data stays yours to read, back up and edit.
PUID=1000
PGID=1000

# Optional, for dictation through Hex (github.com/anomalyco/hex) when it runs on this server's desktop:
# this turns on docker-compose.yml's `hex` service. Run Hex once and create data/hex first.
# COMPOSE_PROFILES=hex
# Hex's folder, if it isn't ~/.local/share/hex.
# HEX_DIR=/home/you/.local/share/hex
